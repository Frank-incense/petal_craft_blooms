# Copy to .env for local development. Never commit .env.

PORT=3000

# memory (no Google credentials needed) | sheets (phase 5)
DATA_STORE=memory

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Required for admin actions. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Public HTTPS origin of this server (no trailing slash), e.g. the Render URL.
# Used to build the M-Pesa callback URL. Must be https:// for STK pushes.
PUBLIC_BASE_URL=

# ---- M-Pesa (Daraja) ----
# Copy these from the Apps Script project's Script Properties.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Defaults to Safaricom's sandbox shortcode 174379 when MPESA_ENVIRONMENT=sandbox.
MPESA_SHORTCODE=
# CustomerPayBillOnline (PayBill) or CustomerBuyGoodsOnline (Till).
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random path segment for the callback URL, 24+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ---- Google Sheets (DATA_STORE=sheets) ----
# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<ID>/edit
# Use a COPY of the live sheet until cutover.
SPREADSHEET_ID=
# Service-account key: paste the JSON on one line, or base64 of the file:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# How often staff edits in the sheet are picked up (ms).
SHEETS_REFRESH_MS=30000
